<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/launch_top"
        android:layout_width="469dp"
        android:layout_height="221dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/launch_top" />

    <ImageView
        android:id="@+id/logo2"
        android:layout_width="233dp"
        android:layout_height="161dp"
        android:layout_marginStart="85dp"
        android:layout_marginTop="55dp"
        android:layout_marginEnd="89dp"
        app:layout_constraintBottom_toTopOf="@+id/launch_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/launch_top"
        app:srcCompat="@drawable/logo2" />

    <ImageView
        android:id="@+id/launch_bottom"
        android:layout_width="424dp"
        android:layout_height="331dp"
        android:layout_marginTop="66dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.538"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo2"
        app:srcCompat="@drawable/launch_bottom" />
</androidx.constraintlayout.widget.ConstraintLayout>